# Select the base image via CUDA_VARIANT.
ARG CUDA_VARIANT="12"
FROM docker.io/nvidia/cuda:12.9.1-devel-ubuntu22.04 AS base-12
FROM docker.io/nvidia/cuda:13.2.1-devel-ubuntu24.04 AS base-13
FROM base-${CUDA_VARIANT} AS base

SHELL ["/bin/bash", "-c"]

# Install system dependencies
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive TZ=Europe/Zurich \
     apt-get install -yqq --no-install-recommends \
       build-essential curl git wget \
  && rm -rf /var/lib/apt/lists/*

# Install gpu_stats (per-GPU/process memory and utilization monitor).
# Link against the CUDA NVML stub at build time (no GPU/driver available here);
# the real libnvidia-ml.so.1 is provided by the NVIDIA container runtime at run
# time. Install into /usr/local/bin so it is on PATH.
RUN git clone --depth 1 https://github.com/AdhocMan/gpu_stats.git /tmp/gpu_stats \
  && git checkout e954a993d588c248ab1b49d2dad37cf48c2f6a4b \
  && make install PREFIX=/usr/local \
  && rm -rf /tmp/gpu_stats

# Install Miniforge
RUN wget -q https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-$(uname -m).sh \
       -O /tmp/miniforge.sh \
  && bash /tmp/miniforge.sh -b -p /opt/conda \
  && rm /tmp/miniforge.sh

ENV PATH="/opt/conda/bin:${PATH}"

# Create conda environment and install conda-only dependencies
RUN conda create -y -n tab python=3.12 pip \
  && conda install -n tab -y python-casacore \
  && conda clean -afy

# Activate the conda env by prepending it to PATH
ENV PATH="/opt/conda/envs/tab/bin:${PATH}" \
    CONDA_DEFAULT_ENV=tab

# Install dependencies
RUN pip install --no-cache-dir "ReFrame-HPC"

# Install Bencher CLI (used for perf tracking in cron jobs)
RUN curl --proto '=https' --tlsv1.2 -sSfL https://bencher.dev/download/install-cli.sh | bash \
  && mv /root/.cargo/bin/bencher /usr/local/bin/bencher

WORKDIR /tabascal/src

# Copy source last to maximise layer cache reuse
COPY . .

# enable FFI CUDA support
ENV TABASCAL_CUDA=1

# Build FFI and install package. The CUDA extra and the pinned jax wheel both
# follow CUDA_VARIANT so they match the selected base image; JAX_VERSION only
# decides whether the jax wheel is pinned ("latest" leaves it unpinned).
ARG JAX_VERSION="latest"
ARG CUDA_VARIANT
RUN if [ "$JAX_VERSION" = "latest" ] || [ -z "$JAX_VERSION" ]; then \
      pip install --no-cache-dir -e ".[test,cuda${CUDA_VARIANT}]"; \
    else \
      pip install --no-cache-dir -e ".[test,cuda${CUDA_VARIANT}]" "jax[cuda${CUDA_VARIANT}]==$JAX_VERSION"; \
    fi
